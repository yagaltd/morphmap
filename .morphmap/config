# MorphMap Project Configuration (LEGACY — see config.json)
# Single source of truth is now .morphmap/config.json.
# This file is kept for reference; model assignments live in JSON.
# Human-maintained. Agents read at startup. Do not hallucinate tools not listed here.

available:
  extensions: [pi-subagents, pi-intercom, context-mode, pi-codex-goal]
  cli: [agent-spec, markmap-cli, bombadil, lonkero, deathcore]
  builtin: [/goal, vcc_recall]
  verified-at: 2026-07-19

# Model strength hierarchy (higher = smarter, more expensive)
# Orchestrator: medium (routing, classification, delegation — pattern matching)
# Branch-agent: strong (spec authoring, integration, bottleneck decisions — technical reasoning)
# Leaf-worker: per bottleneck tag (standard=cheap, blocking=strongest)

orchestratorProfile:
  model: "deepseek/deepseek-v4-pro"
  thinking: "high"

leafProfiles:
  standard:    { model: "deepseek/deepseek-v4-flash", thinking: "off" }
  risky:       { model: "deepseek/deepseek-v4-pro",  thinking: "high" }
  blocking:    { model: "anthropic/claude-sonnet-4",  thinking: "max" }
  time:        { model: "deepseek/deepseek-v4-flash", thinking: "high" }
  verify:      { model: "deepseek/deepseek-v4-pro",  thinking: "high" }

# taskProfiles — per agent+domain+task type when spawning subagents
# branch-agent reads bottleneck tag + domain + task type → picks profile
# passes model/thinking inline in subagent() call
taskProfiles:
  plan-scout:          { model: "deepseek/deepseek-v4-flash", thinking: "off" }
  plan-grill:          { model: "deepseek/deepseek-v4-pro",  thinking: "max" }
  build-backend:       { model: "deepseek/deepseek-v4-pro",  thinking: "high" }
  build-frontend:      { model: "zai/glm-5.2",              thinking: "high" }
  build-generic:       { model: "deepseek/deepseek-v4-pro",  thinking: "high" }
  review-mechanical:   { model: "deepseek/deepseek-v4-flash", thinking: "off" }
  review-judgment:     { model: "anthropic/claude-sonnet-4",  thinking: "high" }
  review-frontend:     { model: "zai/glm-5.2",              thinking: "high" }
  research-pass:       { model: "deepseek/deepseek-v4-flash", thinking: "off" }
  research-verify:     { model: "deepseek/deepseek-v4-pro",  thinking: "high" }

# Agent definitions at ~/.pi/agent/agents/morphmap/ (user scope)
# morphmap/branch-agent, morphmap/leaf-worker, morphmap/reviewer, morphmap/scout, morphmap/researcher
specsDirectory: .morphmap/specs/
